    local function isNamed(key) return data.names[key] and data.names[key] ~= "" end
    local function displayName(key, e)
        if isNamed(key) then return data.names[key] end
        if key == "?" then return "Não identificado" end
        if e and e.text and e.text ~= "" then return e.text end
        return "Peixe #" .. (e and e.id or 0)
    end

    local function indexOf(list, v)
        for i, x in ipairs(list) do if x == v then return i end end
    end
    local function trim(t) return t:match("^%s*(.-)%s*$") end

    -- "Seixo ×2" / "Seixo x2" / "2x Seixo"  ->  nome base + multiplicador
    local function parseName(name)
        local n = name:gsub("×", "x")
        local base, m = n:match("^(.-)%s+[xX]%s*(%d+)$")
        if base and base ~= "" then return base, math.max(1, tonumber(m)) end
        local m2, base2 = n:match("^(%d+)%s*[xX]%s+(.+)$")
        if m2 then return base2, math.max(1, tonumber(m2)) end
        return name, 1
    end

    -- itens com o mesmo nome base viram uma linha só; o multiplicador vale por aviso
    local function groupInfo(key, e)
        local nm = displayName(key, e)
        if isNamed(key) then
            local base, m = parseName(nm)
            return "n:" .. base:lower(), base, m
        end
        return "k:" .. key, nm, 1
    end

    local function seedGroupOrder()
        if #data.gorder == 0 and #data.order > 0 then
            local seen = {}
            for _, k in ipairs(data.order) do
                local gid
                if isNamed(k) then gid = "n:" .. (parseName(data.names[k])):lower() else gid = "k:" .. k end
                if not seen[gid] then seen[gid] = true; data.gorder[#data.gorder + 1] = gid end
            end
        end
    end
    local function swapGroups(g1, g2)
        local i1, i2 = indexOf(data.gorder, g1), indexOf(data.gorder, g2)
        if i1 and i2 then data.gorder[i1], data.gorder[i2] = data.gorder[i2], data.gorder[i1]; saveData() end
    end

