    ------------------------------------------------------------------ MINIGAME
    local function pgFind(path)
        local o = lp:FindFirstChild("PlayerGui")
        for part in path:gmatch("[^%.]+") do
            o = o and o:FindFirstChild(part)
            if not o then return nil end
        end
        return o
    end

    local function mgVisible()
        local o = pgFind(MG)
        local c = o
        while c and c:IsA("GuiObject") do
            if not c.Visible then return false end
            c = c.Parent
        end
        return o ~= nil
    end

    local function markerAngle()
        local track, mk = pgFind(MG .. ".Track"), pgFind(MG .. ".Track.Marker")
        if not (track and mk) then return nil end
        local d = (mk.AbsolutePosition + mk.AbsoluteSize / 2) - (track.AbsolutePosition + track.AbsoluteSize / 2)
        return math.deg(math.atan2(d.X, -d.Y)) % 360   -- 0 = em cima, cresce no sentido horário
    end

    local function overHud(p)
        local a, s = win.AbsolutePosition, win.AbsoluteSize
        return win.Visible and p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
    end

    local function mouse(down, x, y)
        if CFG.useVIM and VIM then
            pcall(function() VIM:SendMouseButtonEvent(x, y, 0, down, game, 0) end)
        elseif mouse1press and mouse1release then
            pcall(down and mouse1press or mouse1release)
        end
    end

    local function doClick()
        local p = UIS:GetMouseLocation()
        if overHud(p) then
            local cam = workspace.CurrentCamera
            p = cam and (cam.ViewportSize / 2) or Vector2.new(500, 300)
        end
        task.spawn(function()
            mouse(true, p.X, p.Y)
            task.wait(0.03)
            mouse(false, p.X, p.Y)
        end)
    end

    local function playMinigame()
        local t0 = os.clock()
        while running and alive and not mg.active and os.clock() - t0 < 1.2 do task.wait(0.03) end
        if not (mg.active and mg.zs and mg.zz and mg.sp) then
            dbg("minigame sem dados da zona")
            local w0 = os.clock()
            while running and mgVisible() and os.clock() - w0 < 15 do task.wait(0.2) end
            return "sem dados"
        end
        local center = (mg.zs * 360 + 90 + mg.zz * 180) % 360
        local speed = mg.sp * 360
        local prev, sign, armed, lastClick = nil, nil, true, 0
        local tStart = os.clock()
        local clicks = 0
        while running and alive and mg.active and os.clock() - tStart < CFG.minigameTimeout do
            local dt = RunService.Heartbeat:Wait()
            local ang = markerAngle()
            if ang then
                local now = os.clock()
                if prev then
                    local d = ((ang - prev + 540) % 360) - 180
                    if math.abs(d) > 0.5 then sign = d > 0 and 1 or -1 end
                end
                prev = ang
                if sign then
                    local rel = ((center - ang) * sign) % 360
                    local t = rel / speed
                    if armed then
                        if rel <= 120 and t <= CFG.clickLead + dt * 0.5 and now - lastClick > 0.28 then
                            doClick()
                            armed, lastClick = false, now
                            clicks = clicks + 1
                        end
                    elseif rel > 150 then
                        armed = true
                    end
                end
            end
        end
        task.wait(0.15)
        dbg(("minigame: %d cliques, resultado %s"):format(clicks, mg.ended and mg.ended.reason or "?"))
        return mg.ended and mg.ended.reason or "timeout"
    end

    ------------------------------------------------------------------ ANDAR ATÉ O ALVO
    local function ensureGrid()
        if grid and not worldDirty then return end
        worldDirty = false
        if not buildGrid() then
            grid = { minCx = -50000 + 1, maxCx = 49999, minCz = -49999, maxCz = 49999, static = {}, parts = 0 }
        end
    end

    local function goTo(it)
        ensureGrid()
        local t0 = os.clock()
        local path, idx = nil, 1
        local replans = 0
        local lastPos, lastT, stuckFor = nil, os.clock(), 0
        local slideAt, slideRem, slides = nil, 0, 0
        local arrive = CFG.arriveDist
        pcall(function() arrive = math.clamp(it.prompt.MaxActivationDistance - 0.8, CFG.arriveDist, CFG.maxArrive) end)

        local r0 = myRoot()
        if not r0 then return false end
        local p0, why0 = planPath(xz(r0.Position), xz(it.part.Position))
        if not p0 then lastNavError = why0 or "?"; return false end
        path = p0

        while running and alive do
            local r = myRoot()
            if not r then
                task.wait(0.2)
            elseif not stillThere(it) then
                releaseAll(); lastNavError = "sumiu"; return false
            elseif os.clock() - t0 > CFG.walkTimeout then
                releaseAll(); lastNavError = "demorou demais"; return false
            elseif sceneChanging then
                releaseAll(); lastNavError = "trocando de cena"; return false
            else
                local now = os.clock()
                local pos = xz(r.Position)
                local k = ckey(toCell(pos.X, pos.Y))
                if learned[k] then learned[k] = nil; learnedDirty = true end -- se passei, não era parede
                local itemPos = xz(it.part.Position)
                local d = (itemPos - pos).Magnitude
                if it.prompt.Enabled and d < arrive + 2 then
                    releaseAll()
                    return true
                end
                if d < arrive then
                    releaseAll()
                    return true
                end
                while idx <= #path and (path[idx] - pos).Magnitude < NAV.reach do idx = idx + 1 end
                -- mira o ponto mais adiante da rota que dá para alcançar em linha reta (com folga das paredes)
                while idx < #path and (path[idx + 1] - pos).Magnitude < 5 and lineFree(pos, path[idx + 1]) do idx = idx + 1 end
                local target = path[idx] or itemPos

                local dt = now - lastT
                if lastPos and (pos - lastPos).Magnitude < 0.1 then stuckFor = stuckFor + dt else stuckFor = 0 end
                lastPos, lastT = pos, now
                if stuckFor > CFG.stuckSeconds then
                    replans = replans + 1
                    stuckFor = 0
                    releaseAll()
                    if idx > #path and d < arrive + 2.5 then
                        -- terminou a rota e está colado no alvo (a parede do minério impede de chegar mais perto)
                        return true
                    end
                    if replans > 12 then lastNavError = "preso demais"; return false end
                    learnBlock(pos, target - pos)
                    local np, why = planPath(pos, itemPos)
                    if not np then lastNavError = why or "?"; return false end
                    path, idx = np, 1
                    target = path[1] or itemPos
                end

                do -- deslizando na parede? (anda, mas quase não chega mais perto do destino)
                    local rem = ((path[idx] or itemPos) - pos).Magnitude
                    for q = idx, #path - 1 do rem = rem + (path[q + 1] - path[q]).Magnitude end
                    if not slideAt then
                        slideAt, slideRem = now, rem
                    elseif now - slideAt >= 0.8 then
                        local v = basis and math.max(basis.fwd.Magnitude, basis.right.Magnitude) or 8
                        local rate = (slideRem - rem) / (now - slideAt)
                        slideAt, slideRem = now, rem
                        if rate < 0.3 * v and rem > NAV.reach + 1.5 and slides < 20 then
                            slides = slides + 1
                            releaseAll()
                            learnBlock(pos, target - pos)
                            local np = planPath(pos, itemPos)
                            if np then
                                path, idx = np, 1
                                target = path[1] or itemPos
                                if dbg then dbg(("deslizando na parede: replanejei a rota (%d)"):format(slides)) end
                            end
                        end
                    end
                end

                local a, b = steer(target - pos)
                drive(a, b)
            end
        end
        releaseAll()
        return false
    end


    ------------------------------------------------------------------ AÇÕES
    local function fireOrTap(it)
        if it.prompt.Enabled then
            tap("E")
            return true
        end
        if fireproximityprompt then
            pcall(fireproximityprompt, it.prompt)
            return true
        end
        return false
    end

    local function waitEnabled(it, secs)
        local w0 = os.clock()
        while running and it.prompt.Enabled == false and os.clock() - w0 < secs do task.wait(0.05) end
    end

    local function mineNode(it)
        if not goTo(it) then return "walk" end
        releaseAll()
        task.wait(0.15)
        waitEnabled(it, 0.8)
        for _ = 1, 2 do
            mg.active, mg.ended = false, nil
            if not fireOrTap(it) then return "noprompt" end
            local t0 = os.clock()
            while running and not (mg.active or mgVisible()) and os.clock() - t0 < CFG.startWait do task.wait(0.05) end
            if mg.active or mgVisible() then
                return playMinigame()
            end
            task.wait(0.3)
        end
        return "nostart"
    end

    local function collectChest(it)
        if not goTo(it) then return false end
        releaseAll()
        task.wait(0.15)
        waitEnabled(it, 0.8)
        if not fireOrTap(it) then return false end
        task.wait(0.8)
        if not stillThere(it) or not it.prompt.Enabled then
            doneChest[it.part] = true
            cfg.totals.chests = cfg.totals.chests + 1
            save()
            return true
        end
        return false
    end

    local function descend(it)
        if not goTo(it) then return false end
        releaseAll()
        task.wait(0.2)
        waitEnabled(it, 1.0)
        local epoch = sceneEpoch
        if not fireOrTap(it) then return false end
        local t0 = os.clock()
        while running and sceneEpoch == epoch and os.clock() - t0 < 8 do task.wait(0.1) end
        if sceneEpoch ~= epoch then
            cfg.totals.floors = cfg.totals.floors + 1
            save()
            task.wait(0.8)
            return true
        end
        return false
    end

    local function findEntrance(me)
        local world = workspace:FindFirstChild(CFG.worldName)
        if not world then return nil end
        local saved, guess, sd, gd
        for _, o in ipairs(world:GetChildren()) do
            if o:IsA("BasePart") then
                local pr = o:FindFirstChildOfClass("ProximityPrompt")
                if pr then
                    local id = o:GetAttribute("Id")
                    local ids = type(id) == "string" and id or ""
                    local nm, idl, act = o.Name:lower(), ids:lower(), pr.ActionText:lower()
                    local d = (Vector2.new(o.Position.X, o.Position.Z) - me).Magnitude
                    local isStrong = (act:find("mina", 1, true) and act:find("entrar", 1, true)) or nm == "cave entry"
                    local isSaved = isStrong or (cfg.entrance and ((cfg.entrance.id ~= "" and ids == cfg.entrance.id) or (cfg.entrance.name == o.Name)))
                    local isGuess = (act:find("entrar", 1, true) or act:find("enter", 1, true) or nm:find("mine", 1, true)
                        or nm:find("mina", 1, true) or idl:find("mine", 1, true) or nm:find("cave", 1, true))
                        and not (nm:find("shop", 1, true) or nm:find("crate", 1, true) or act:find("suprimento", 1, true))
                    local it = { part = o, prompt = pr, id = id, kind = "entrance", name = o.Name }
                    if isSaved and (not sd or d < sd) then saved, sd = it, d end
                    if isGuess and (not gd or d < gd) then guess, gd = it, d end
                end
            end
        end
        if saved or guess then return saved or guess end
        -- plano B: logo depois de ser expulso você fica na porta; o botão ativo mais perto é a entrada
        local near, nd
        for _, o in ipairs(world:GetChildren()) do
            if o:IsA("BasePart") then
                local pr = o:FindFirstChildOfClass("ProximityPrompt")
                if pr and pr.Enabled then
                    local nm, act = o.Name:lower(), pr.ActionText:lower()
                    if not (nm:find("shop", 1, true) or nm:find("crate", 1, true) or act:find("suprimento", 1, true)) then
                        local d = (Vector2.new(o.Position.X, o.Position.Z) - me).Magnitude
                        if d < 10 and (not nd or d < nd) then
                            local id = o:GetAttribute("Id")
                            near, nd = { part = o, prompt = pr, id = id, kind = "entrance", name = o.Name, auto = true }, d
                        end
                    end
                end
            end
        end
        return near
    end

    local function walkStraight(ent, secs)
        local t0 = os.clock()
        while running and alive and os.clock() - t0 < secs do
            local r = myRoot()
            if not r then break end
            local to = xz(ent.part.Position) - xz(r.Position)
            if to.Magnitude < 1.6 then break end
            local a, b = steer(to)
            drive(a, b)
        end
        releaseAll()
    end

    local function enterMine(me)
        local ent = findEntrance(me)
        if not ent then
            setStatus("Fora da mina. Não achei a entrada: fique perto dela e aperte \"Marcar entrada\".", C.accent)
            dbg("entrada não encontrada")
            return false
        end
        items = { ent }
        worldDirty = true
        local range = 5
        pcall(function() range = math.max(4, ent.prompt.MaxActivationDistance) end)
        local function distTo()
            local r = myRoot()
            return r and (xz(r.Position) - xz(ent.part.Position)).Magnitude or math.huge
        end
        setStatus("Fora da mina. Entrando (" .. ent.name .. ")…", C.accent)
        dbg(("entrar: %s dist=%.1f alcance=%.1f ligado=%s"):format(ent.name, distTo(), range, tostring(ent.prompt.Enabled)))
        -- depois de ser expulso você já nasce na porta: tenta o E antes de sair andando
        if distTo() > range - 0.5 then
            if not goTo(ent) then
                dbg("andar até a porta falhou (" .. tostring(lastNavError) .. "), dist=" .. ("%.1f"):format(distTo()))
                if distTo() < 16 then walkStraight(ent, 4) else return false end
            end
            releaseAll()
        end
        for attempt = 1, 4 do
            if not (running and alive) then return false end
            local epoch = sceneEpoch
            task.wait(0.2)
            waitEnabled(ent, 1.0)
            if attempt == 1 then
                fireOrTap(ent)
            elseif attempt == 2 then
                if fireproximityprompt then pcall(fireproximityprompt, ent.prompt) else tap("E") end
            elseif attempt == 3 then
                tap("E"); task.wait(0.3); tap("E")
            else
                walkStraight(ent, 2.5)
                fireOrTap(ent)
            end
            local t0 = os.clock()
            while running and os.clock() - t0 < 4 do
                scan()
                if sceneEpoch ~= epoch or sceneChanging or worldInMine() then
                    if ent.auto then
                        local id = ent.part:GetAttribute("Id")
                        cfg.entrance = { name = ent.name, id = type(id) == "string" and id or "" }
                        save()
                        dbg("entrada aprendida automaticamente: " .. ent.name)
                    end
                    return true
                end
                task.wait(0.25)
            end
            dbg("tentativa " .. attempt .. " de entrar sem efeito")
        end
        return false
    end

    ------------------------------------------------------------------ DECISÃO
    local function dist2(it, me)
        return (Vector2.new(it.part.Position.X, it.part.Position.Z) - me).Magnitude
    end

    local function available(it)
        local now = os.clock()
        return stillThere(it) and not (skipUntil[it.part] and skipUntil[it.part] > now)
    end

    local function nearest(list, me, filter)
        local best, bd
        for _, it in ipairs(list) do
            if available(it) and (not filter or filter(it)) then
                local d = dist2(it, me)
                if not bd or d < bd then best, bd = it, d end
            end
        end
        return best, bd
    end

    local function typeWanted(it)
        return cfg.types[it.name] ~= false and not locked[it.name]
    end

    -- devolve { kind = "mine"|"chest"|"descend"|"wait", it = ..., why = ... }
    local function decide(me)
        local f = floor or 0
        local canDescend = (cfg.stopFloor == 0) or (f < cfg.stopFloor)
        local descendOnly = (cfg.mode == 3) or (cfg.descendUntil > 0 and floor ~= nil and floor < cfg.descendUntil)
        local descentOk = descent and available(descent) and canDescend

        local function anyOre(it) return not locked[it.name] end

        if descendOnly then
            if descentOk then return { kind = "descend", it = descent } end
            if cfg.chests then
                local c, d = nearest(chests, me, function(it) return not doneChest[it.part] end)
                if c and d < 30 then return { kind = "chest", it = c } end
            end
            local o = nearest(ores, me, anyOre)
            if o then return { kind = "mine", it = o, why = "procurando a escada" } end
            return { kind = "wait", why = descent and "Andar final alcançado." or "Sem minério e sem escada visíveis…" }
        end

        if cfg.asap and descentOk then return { kind = "descend", it = descent } end

        local pool
        if cfg.mode == 1 then pool = nearest(ores, me, anyOre)
        else pool = nearest(ores, me, typeWanted) end
        local chest
        if cfg.chests then chest = nearest(chests, me, function(it) return not doneChest[it.part] end) end
        if chest and pool then
            if dist2(chest, me) < dist2(pool, me) + 25 then return { kind = "chest", it = chest } end
        elseif chest then
            return { kind = "chest", it = chest }
        end
        if pool then return { kind = "mine", it = pool } end
        if descentOk then return { kind = "descend", it = descent } end
        if canDescend then
            local o = nearest(ores, me, anyOre)
            if o then return { kind = "mine", it = o, why = "para a escada aparecer" } end
        end
        if not canDescend and f > 0 then
            return { kind = "wait", why = ("Andar %d concluído. Esperando a mina reiniciar…"):format(f) }
        end
        return { kind = "wait", why = "Nada para fazer agora (esperando)…" }
    end

    ------------------------------------------------------------------ HUD
    local typesSig = ""
    local function oreLabel(n) return ORE_LABEL[n] or n end

    local rebuildTypes
    function rebuildTypes()
        local names, seen = {}, {}
        for n in pairs(typeCount) do names[#names + 1] = n; seen[n] = true end
        for n in pairs(cfg.totals.ore) do if not seen[n] then names[#names + 1] = n; seen[n] = true end end
        table.sort(names, function(a, b)
            local oa, ob = ORE_ORDER[a] or 99, ORE_ORDER[b] or 99
            if oa ~= ob then return oa < ob end
            return a < b
        end)
        local sig = {}
        for _, n in ipairs(names) do
            sig[#sig + 1] = ("%s%d%d%s%s"):format(n, typeCount[n] or 0, cfg.totals.ore[n] or 0, tostring(cfg.types[n] ~= false), tostring(locked[n] == true))
        end
        local s = table.concat(sig, ",")
        if s == typesSig then return end
        typesSig = s
        for _, c in ipairs(typesBox:GetChildren()) do
            if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
        end
        if #names == 0 then
            new("TextLabel", { Text = "Os minérios aparecem aqui quando você entra na mina.", Font = Enum.Font.Gotham,
                TextSize = 11, TextColor3 = C.muted, TextWrapped = true, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 30) }, typesBox)
            return
        end
        for i, n in ipairs(names) do
            local on = cfg.types[n] ~= false
            local txt = ("%s %s   ·  andar: %d  ·  total: %d"):format(on and "☑" or "☐", oreLabel(n), typeCount[n] or 0, cfg.totals.ore[n] or 0)
            if locked[n] then txt = txt .. "  ·  picareta fraca?" end
            local b = new("TextButton", { Text = txt, Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = locked[n] and C.accent or (on and C.text or C.muted),
                TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = C.bg, Size = UDim2.new(1, 0, 0, 24),
                LayoutOrder = i }, typesBox)
            round(b, 7)
            new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, b)
            b.MouseButton1Click:Connect(function()
                if locked[n] then locked[n] = nil; typeFails[n] = nil else cfg.types[n] = not on end
                save()
                typesSig = ""
                rebuildTypes()
            end)
        end
    end

    local function fmtTime(t)
