    ------------------------------------------------------------------ LOCALIZADOR (marcadores na tela)
    local markers = {}
    local function getMarker(i)
        local m = markers[i]
        if not m then
            m = new("TextLabel", {
                Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = C.text,
                BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, AutomaticSize = Enum.AutomaticSize.X,
                Size = UDim2.fromOffset(0, 20), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, BorderSizePixel = 0,
            }, gui)
            round(m, 10)
            new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, m)
            new("UIStroke", { Thickness = 1.5, Color = C.accent }, m)
            markers[i] = m
        end
        return m
    end

    local function updateEsp()
        local cam = workspace.CurrentCamera
        local r = myRoot()
        if not (espOn and cam and r) then
            for _, m in ipairs(markers) do m.Visible = false end
            return
        end
        local list = {}
        for _, it in ipairs(items) do
            if stillThere(it) and wanted(it) then
                list[#list + 1] = { it = it, d = (it.part.Position - r.Position).Magnitude, t = tierOf(it) }
            end
        end
        table.sort(list, function(a, b)
            if a.t ~= b.t then return a.t > b.t end
            return a.d < b.d
        end)
        local vs = cam.ViewportSize
        local n = math.min(#list, 24)
        for i = 1, n do
            local e = list[i]
            local tier = TIERS[e.t]
            local m = getMarker(i)
            local v = cam:WorldToViewportPoint(e.it.part.Position + Vector3.new(0, 1.5, 0))
            local x, y = v.X, v.Y
            if v.Z < 0 then x, y = vs.X - x, vs.Y - y end
            local arrowL, arrowR = "", ""
            local M = 46
            if x < M then arrowL = "◀ " elseif x > vs.X - M then arrowR = " ▶"
            elseif y < M then arrowL = "▲ " elseif y > vs.Y - M then arrowL = "▼ " end
            m.Position = UDim2.fromOffset(math.clamp(x, M, vs.X - M), math.clamp(y, M, vs.Y - M))
            m.Text = ("%s%s%s · %dm%s"):format(arrowL, tier.stars ~= "" and (tier.stars .. " ") or "", e.it.name, math.floor(e.d), arrowR)
            local st = m:FindFirstChildOfClass("UIStroke")
            if st then st.Color = tier.color end
            m.TextColor3 = (e.t >= 3) and tier.color or C.text
            m.Visible = true
        end
        for i = n + 1, #markers do markers[i].Visible = false end
    end

    ------------------------------------------------------------------ LOOP PRINCIPAL
    local function worker()
        local lastSave = os.clock()
        while alive do
            if learnedDirty and os.clock() - lastSave > 20 then saveMap(); lastSave = os.clock() end
            if not running then
                task.wait(0.2)
            else
                local r = myRoot()
                if not r then
                    setStatus("Aguardando o personagem…")
                    task.wait(0.5)
                elseif not basis then
                    setStatus("Calibrando as teclas (andando um pouco)…", C.accent)
                    if not calibrate() then
                        running = false
                        startBtn.Text = "▶  Iniciar coleta"
                        startBtn.BackgroundColor3 = C.accent
                        if runSince then elapsed = elapsed + (os.clock() - runSince); runSince = nil end
                        setStatus("Não consegui calibrar. Fique numa área aberta e tente de novo.", C.accent)
                    else
                        setStatus("Calibrado!", C.ok)
                    end
                elseif not grid then
                    setStatus("Lendo o mapa (paredes, rios, árvores)…", C.accent)
                    if not buildGrid() then
                        grid = nil
                        setStatus("Não achei as paredes do mapa. Vou andar em linha reta (use 'Exportar mapa').", C.accent)
                        task.wait(1.5)
                        grid = { minCx = -50000 + 1, maxCx = 49999, minCz = -49999, maxCz = 49999, static = {}, parts = 0 }
                    end
                else
                    local it = pickTarget(xz(r.Position))
                    if not it then
                        setStatus("Nada para coletar agora (esperando itens aparecerem)…")
                        task.wait(1.5)
                    else
                        local tier = TIERS[tierOf(it)]
                        local dist = math.floor((xz(it.part.Position) - xz(r.Position)).Magnitude)
                        setStatus(("Indo até %s%s (%dm)…"):format(tier.stars ~= "" and (tier.stars .. " ") or "", it.name, dist),
                            tierOf(it) >= 3 and tier.color or C.text)
                        if goTo(it) then
                            if running and stillThere(it) then
                                setStatus(("Coletando %s…"):format(it.name), C.ok)
                                if collect(it) then
                                    collected[it.name] = (collected[it.name] or 0) + 1
                                    collectedTotal = collectedTotal + 1
                                    if tierOf(it) >= 3 then collectedRare = collectedRare + 1 end
                                    attempts[it.part] = nil
                                    setStatus(("Coletou %s%s!"):format(tier.stars ~= "" and (tier.stars .. " ") or "", it.name), tier.color)
                                else
                                    attempts[it.part] = (attempts[it.part] or 0) + 1
                                    if attempts[it.part] >= CFG.maxAttempts then
                                        skipUntil[it.part] = os.clock() + CFG.skipSeconds
                                        attempts[it.part] = nil
                                    end
                                end
                            end
                        elseif running and stillThere(it) then
                            skipUntil[it.part] = os.clock() + 90
                            setStatus(("Não consegui chegar em %s (%s). Pulando por um tempo."):format(it.name, lastNavError), C.accent)
                            task.wait(0.8)
                        end
                        task.wait(0.25 + math.random() * 0.25)
                    end
                end
            end
        end
    end

    ------------------------------------------------------------------ BOTÕES / TECLAS
    local function toggleRun()
        running = not running
        if running then
            runSince = os.clock()
            setStatus("Iniciando…")
        else
            if runSince then elapsed = elapsed + (os.clock() - runSince); runSince = nil end
            releaseAll()
            if learnedDirty then saveMap() end
            setStatus("Parado.")
        end
        startBtn.Text = running and "■  Parar coleta" or "▶  Iniciar coleta"
        startBtn.BackgroundColor3 = running and C.line or C.accent
    end
