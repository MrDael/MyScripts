    -- devolve a lista de itens (um por aviso, com a quantidade quando existir) + relatório
    local function detectItems(base)
        local pg = lp:FindFirstChild("PlayerGui")
        if not pg then return end
        local new_ = {}
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("GuiObject") and not base[o] and not o:IsDescendantOf(gui) and visible(o) and not ignored(o) then
                new_[#new_ + 1] = o
            end
        end
        if #new_ == 0 then return end

        local parts, glyphGroups, glyphImgs = {}, {}, {}
        for _, o in ipairs(new_) do
            if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text ~= "" then
                parts[#parts + 1] = { obj = o, kind = "T", s = "T:" .. o.Text, text = o.Text, n = #o.Text }
            elseif o:IsA("ImageLabel") and o.Name:match("^Glyph%d*$") then
                local par = o.Parent
                glyphGroups[par] = glyphGroups[par] or {}
                table.insert(glyphGroups[par], o)
                glyphImgs[o.Image] = true
            end
        end
        for par, list in pairs(glyphGroups) do
            table.sort(list, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
            local sig = {}
            for _, g in ipairs(list) do
                local ro, rs = g.ImageRectOffset, g.ImageRectSize
                sig[#sig + 1] = ("%s@%d,%d,%d,%d"):format(g.Image, ro.X, ro.Y, rs.X, rs.Y)
            end
            parts[#parts + 1] = { obj = par, kind = "G", s = "G:" .. table.concat(sig, ","), n = #list }
        end
        for _, o in ipairs(new_) do
            if o:IsA("ImageLabel") and o.Image ~= "" and not o.Name:match("^Glyph%d*$") and not glyphImgs[o.Image] then
                local ro, rs = o.ImageRectOffset, o.ImageRectSize
                parts[#parts + 1] = { obj = o, kind = "I", n = 0,
                    s = ("I:%s@%d,%d,%d,%d"):format(o.Image, ro.X, ro.Y, rs.X, rs.Y) }
            end
        end

        if CFG.leftOnly then
            local cam = workspace.CurrentCamera
            local vw = cam and cam.ViewportSize.X or 1920
            local left = {}
            for _, p in ipairs(parts) do if p.obj.AbsolutePosition.X < vw * 0.6 then left[#left + 1] = p end end
            if #left > 0 then parts = left end
        end
        if #parts == 0 then return end

        local function chain(o)
            local t, c = {}, o
            while c and c ~= pg do table.insert(t, 1, c); c = c.Parent end
            return t
        end
        local first = chain(parts[1].obj)
        local depth = #first
        for i = 2, #parts do
            local ch, d = chain(parts[i].obj), 0
            for k = 1, math.min(depth, #ch) do
                if ch[k] == first[k] then d = k else break end
            end
            depth = d
        end
        local node = first[depth]

        -- separa em avisos: filhos do ancestral comum, empilhados na vertical e com a mesma forma
        local groups = { parts }
        if node and #parts > 1 then
            local buckets, order = {}, {}
            for _, p in ipairs(parts) do
                local c = p.obj
                while c and c.Parent ~= node do c = c.Parent end
                c = c or node
                if not buckets[c] then buckets[c] = { parts = {} }; order[#order + 1] = c end
                table.insert(buckets[c].parts, p)
            end
            if #order >= 2 then
                local info, okSplit, pattern = {}, true, nil
                for _, c in ipairs(order) do
                    local kinds, top, bot = {}, math.huge, -math.huge
                    for _, p in ipairs(buckets[c].parts) do
                        kinds[#kinds + 1] = p.kind
                        top = math.min(top, p.obj.AbsolutePosition.Y)
                        bot = math.max(bot, p.obj.AbsolutePosition.Y + p.obj.AbsoluteSize.Y)
                    end
                    table.sort(kinds)
                    local pat = table.concat(kinds)
                    pattern = pattern or pat
                    if pat ~= pattern then okSplit = false end
                    info[#info + 1] = { top = top, bot = bot }
                end
                for i = 1, #info do
                    for j = i + 1, #info do
                        local ov = math.min(info[i].bot, info[j].bot) - math.max(info[i].top, info[j].top)
                        local h = math.min(info[i].bot - info[i].top, info[j].bot - info[j].top)
                        if h > 0 and ov > h * 0.3 then okSplit = false end
                    end
                end
                if okSplit then
                    groups = {}
                    for _, c in ipairs(order) do groups[#groups + 1] = buckets[c].parts end
                    table.sort(groups, function(a, b)
                        return a[1].obj.AbsolutePosition.Y < b[1].obj.AbsolutePosition.Y
                    end)
                end
            end
        end

        -- cada aviso = 1 item. Nome = grupo de letras mais longo; grupo curto ao lado = quantidade ("x2")
        local items = {}
        for _, g in ipairs(groups) do
            local best
            for _, p in ipairs(g) do
                if p.kind ~= "I" and (not best or p.n > best.n) then best = p end
            end
            best = best or g[1]
            local qparts = {}
            if best.kind ~= "I" then
                for _, p in ipairs(g) do
                    if p ~= best and p.kind ~= "I" and p.n <= 5 then qparts[#qparts + 1] = p end
                end
            end
            table.sort(qparts, function(a, b) return a.obj.AbsolutePosition.X < b.obj.AbsolutePosition.X end)
            local qsig, qnum
            if #qparts > 0 then
                local ss, tt = {}, {}
                for _, p in ipairs(qparts) do
                    ss[#ss + 1] = p.s
                    if p.text then tt[#tt + 1] = p.text end
                end
                qsig = table.concat(ss, "+")
                if #tt > 0 then qnum = tonumber(table.concat(tt, " "):match("%d+")) end
            end
            items[#items + 1] = { key = best.s, text = best.text, qsig = qsig, qnum = qnum }
        end

        local dump = { ("ITENS: %d (avisos separados: %s)"):format(#items, #groups > 1 and "sim" or "não"), "" }
        for i, it in ipairs(items) do
            dump[#dump + 1] = ("  [%d] nome=%s | qtd=%s"):format(i, it.key, tostring(it.qsig or "-"))
        end
        dump[#dump + 1] = ""
        for i, o in ipairs(new_) do
            if i > 250 then break end
            local ro, rs = Vector2.zero, Vector2.zero
            if o:IsA("ImageLabel") then ro, rs = o.ImageRectOffset, o.ImageRectSize end
            dump[#dump + 1] = ("%s [%s] pos=(%d,%d) size=(%d,%d)%s%s"):format(
                o:GetFullName(), o.ClassName, o.AbsolutePosition.X, o.AbsolutePosition.Y,
                o.AbsoluteSize.X, o.AbsoluteSize.Y,
                o:IsA("ImageLabel") and (" image=" .. o.Image .. " rect=" .. ro.X .. "," .. ro.Y .. "," .. rs.X .. "," .. rs.Y) or "",
                (o:IsA("TextLabel") or o:IsA("TextButton")) and (' text="' .. o.Text .. '"') or "")
        end
        return items, table.concat(dump, "\n")
    end

    local function recordCatchOld(base)
        local t0 = os.clock()
        local lastSig, lastItems, lastDump, stable = nil, nil, nil, 0
        task.wait(0.3)
        while alive and os.clock() - t0 < 6 do
            local items, dump = detectItems(base)
            if items then
                local keys = {}
                for _, it in ipairs(items) do keys[#keys + 1] = it.key .. "#" .. tostring(it.qsig or "") end
                local sig = table.concat(keys, "||")
                lastItems, lastDump = items, dump
                if sig == lastSig then stable = stable + 1 else lastSig, stable = sig, 0 end
                if stable >= 3 then break end -- 4 leituras iguais = todos os avisos já apareceram
            end
            task.wait(0.25)
        end
        if lastDump and writefile then pcall(writefile, "caramelo_ultima_captura.txt", lastDump) end

        local labels = {}
        for _, it in ipairs(lastItems or { { key = "?" } }) do
            local qty = it.qnum or (it.qsig and data.qty[it.qsig]) or 1
            if addFish(it.key, it.text, qty) then
                local unknownQ = it.qsig and not it.qnum and not data.qty[it.qsig]
                if unknownQ then pendingQ[#pendingQ + 1] = { qsig = it.qsig, key = it.key } end
                local base, mult = parseName(displayName(it.key, fishLog[it.key]))
                local label = base .. (unknownQ and " ×?" or (" ×" .. (qty * mult)))
                if it.key ~= "?" and not isNamed(it.key) then label = label .. " (sem nome)" end
                labels[#labels + 1] = label
            end
        end
        local joined = #labels > 0 and table.concat(labels, " + ") or "(item ignorado)"
        dexLast.Text = "Última pesca: " .. joined
        setStatus((#labels > 1 and ("Pescou %d itens: "):format(#labels) or "Pescou: ") .. joined, C.ok)
        showPending(); rebuildDex()
    end

    ------------------------------------------------------------------ ITENS PELO SERVIDOR (nome/quantidade/raridade reais)
    -- o jogo avisa cada item recebido com inventoryItemAdded({ itemId = "...", quantity = N }); usamos isso em vez de ler o texto da tela
    local RSv = game:GetService("ReplicatedStorage")
    local invEvents, itemsData, locFns, nameCache = {}, nil, {}, {}
    task.spawn(function()
        pcall(function()
            for _, o in ipairs(RSv:GetDescendants()) do
                if o:IsA("RemoteEvent") and o.Name == "inventoryItemAdded" then
                    table.insert(conns, o.OnClientEvent:Connect(function(p)
                        if type(p) == "table" and type(p.itemId) == "string" then
                            invEvents[#invEvents + 1] = { id = p.itemId, q = math.max(1, tonumber(p.quantity) or 1), t = os.clock() }
                            if #invEvents > 300 then table.remove(invEvents, 1) end
                        end
                    end))
                    break
                end
            end
        end)
        pcall(function()
            local m = RSv.TS.data:FindFirstChild("items")
            local mod = m and HUB.requireTimeout(m, 4)
            if type(mod) == "table" and type(mod.items) == "table" then itemsData = mod.items end
        end)
        for _, lang in ipairs({ "pt-br", "en-us" }) do
            pcall(function()
                local m = RSv.TS.data.localizations:FindFirstChild(lang)
                m = m and m:FindFirstChild("items")
                local mod = m and HUB.requireTimeout(m, 4)
                if mod ~= nil then locFns[#locFns + 1] = mod end
            end)
        end
    end)
    local function humanize(id)
        local t = tostring(id):gsub("[-_]+", " ")
        return (t:gsub("^%l", string.upper))
    end
    local function textFrom(v, id)
        if type(v) == "string" and v ~= "" and v ~= id then return v end
        if type(v) == "table" then
            local n = v.name or v.Name or v.title
            if type(n) == "string" and n ~= "" and n ~= id then return n end
        end
    end
    local function lookupLoc(src, id)
        if type(src) == "table" then
            local r = textFrom(src[id], id) or textFrom(src[id .. ".name"], id)
            if r then return r end
            if type(src.items) == "table" then return textFrom(src.items[id], id) end
        elseif type(src) == "function" then
            local ok, r = pcall(src)
            if ok and type(r) == "table" then return lookupLoc(r, id) end
            if ok and type(r) == "string" then return nil end
            for _, arg in ipairs({ id, id .. ".name", "items." .. id .. ".name" }) do
                local ok2, r2 = pcall(src, arg)
                local t = ok2 and textFrom(r2, id)
                if t then return t end
            end
        end
    end
    local function itemName(id)
        if nameCache[id] then return nameCache[id] end
        local nm
        for _, src in ipairs(locFns) do
            nm = lookupLoc(src, id)
            if nm then break end
        end
        nm = nm or humanize(id)
        if #locFns > 0 or itemsData then nameCache[id] = nm end
        return nm
    end
    local RARITY_PT = { common = "comum", uncommon = "incomum", rare = "raro", epic = "épico", legendary = "lendário",
        mythic = "mítico", divine = "divino", transcendent = "transcendente" }
    local function itemRarity(id)
        local it = itemsData and itemsData[id]
        return it and it.rarity or nil
    end

    -- junta os itens recebidos desde "since" e coloca no registro; se o servidor não avisar nada, usa a leitura antiga da tela
    local function recordCatch(base, since)
        local t0 = os.clock()
        local items = {}
        while alive and os.clock() - t0 < 3.5 do
            items = {}
            local lastT = 0
            for _, e in ipairs(invEvents) do
                if not e.used and e.t >= since then items[#items + 1] = e; lastT = math.max(lastT, e.t) end
            end
            if #items > 0 and os.clock() - lastT > 0.8 then break end
            task.wait(0.15)
        end
        if #items == 0 then return recordCatchOld(base) end

        local agg, order = {}, {}
        for _, e in ipairs(items) do
            e.used = true
            if not agg[e.id] then agg[e.id] = 0; order[#order + 1] = e.id end
            agg[e.id] = agg[e.id] + e.q
        end
        local labels, special = {}, nil
        for _, id in ipairs(order) do
            local key = "id:" .. id
            local rar = itemRarity(id)
            if addFish(key, itemName(id), agg[id]) then
                local lbl = displayName(key, fishLog[key]) .. " ×" .. agg[id]
                if rar and rar ~= "common" then lbl = lbl .. " (" .. (RARITY_PT[rar] or rar) .. ")" end
                labels[#labels + 1] = lbl
                if rar and rar ~= "common" and rar ~= "uncommon" then special = lbl end
            end
        end
        local joined = #labels > 0 and table.concat(labels, " + ") or "(item ignorado)"
        dexLast.Text = "Última pesca: " .. joined
        setStatus("Pescou: " .. joined, C.ok)
        if special then HUB.notify("good", "Pescou algo especial", special) end
        pcall(function()
            if appendfile then appendfile("caramelo_pesca_log.txt", ("[pesca] %s\n"):format(joined)) end
        end)
        rebuildDex()
    end

    ------------------------------------------------------------------ LOOP PRINCIPAL
    local function worker()
        while alive do
            if not running then
                task.wait(0.2)
            elseif not water then
                running = false
                startBtn.Text = "▶  Iniciar"
                setStatus("Marque a área da água primeiro (Delete).", C.accent)
            else
                -- antes de lançar: espera sobrar nada da pesca anterior (balão / minigame)
                local c0 = os.clock()
                while running and (rootOn() or biteOn()) and os.clock() - c0 < 6 do task.wait(0.1) end

                if running then
                    setStatus("Lançando o anzol…")
                    clickAt(water)
                    task.wait(CFG.minDelayCast + math.random())
                end

                -- só aceita a exclamação depois que o balão ficou "apagado" um tempo
                -- (evita clicar numa exclamação velha e estragar o ciclo)
                local a0, calmSince = os.clock(), nil
                while running and alive and os.clock() - a0 < 5 do
                    if biteOn() then calmSince = nil
                    else
                        calmSince = calmSince or os.clock()
                        if os.clock() - calmSince > 0.4 then break end
                    end
                    task.wait(0.05)
                end

                setStatus("Aguardando o peixe morder…")
                local base
                local t0, bitten, seen = os.clock(), false, 0
                rareNow = false
                while running and alive and os.clock() - t0 < CFG.biteTimeout do
                    if not rareNow and blueOn() then
                        rareNow = true
                        rareSeen = rareSeen + 1
                        setStatus("Exclamação AZUL: peixe raro vindo!", C.accent)
                        HUB.notify("good", "Peixe raro!", "Exclamação azul apareceu.")
                        refreshInfo()
                    end
                    logIcon()
                    if minigameOn() then base = snapshot(); bitten = true; break end
                    if biteOn() then seen += 1 else seen = 0 end
                    if seen >= 2 then -- 2 leituras seguidas = exclamação de verdade
                        setStatus("Fisgou! Clicando…", C.ok)
                        base = snapshot()
                        task.wait(rand(CFG.reactMin, CFG.reactMax))
                        clickAt(water)
                        bitten = true
                        break
                    end
                    task.wait(0.04)
                end

                if running and bitten then
                    local w0 = os.clock()
                    while running and not minigameOn() and os.clock() - w0 < 5 do
                        task.wait(0.05)
                    end
                    if minigameOn() then
                        base = base or snapshot()
                        local playStart = os.clock() - 0.5
                        local won, pr = play()
                        if won then
                            caught += 1
                            if rareNow then rareCaught = rareCaught + 1 end
                            task.spawn(recordCatch, base, playStart)
                            setStatus(rareNow and "Peixe RARO capturado!" or "Peixe capturado!", C.ok)
                            if rareNow then HUB.notify("good", "Raro capturado!", "Veja em Peixes pescados.") end
                        else
                            escaped += 1
                            setStatus(("O peixe fugiu (barra em %d%%)."):format(math.floor((pr or 0) * 100)), C.accent)
                        end
                        refreshInfo()
                    end
                end
                setHold(false)
                if running then task.wait(rand(CFG.pauseMin, CFG.pauseMax)) end
            end
        end
    end

    ------------------------------------------------------------------ BOTÕES / TECLAS
    local function overFrame(f, p)
        local a, sz = f.AbsolutePosition, f.AbsoluteSize
        return f.Visible and p.X >= a.X and p.X <= a.X + sz.X and p.Y >= a.Y and p.Y <= a.Y + sz.Y
    end

    local function toggleRun()
        if not running and water and (overFrame(win, water) or overFrame(dex, water)) then
            setStatus("A área da água está atrás do HUD. Mova o HUD ou marque a água de novo.", C.accent)
            return
        end
        running = not running
        if running then runSince = os.clock()
        elseif runSince then elapsed = elapsed + (os.clock() - runSince); runSince = nil end
        startBtn.Text = running and "■  Parar" or "▶  Iniciar"
        startBtn.BackgroundColor3 = running and C.line or C.accent
        if not running then setHold(false); setStatus("Parado.") end
    end
    startBtn.MouseButton1Click:Connect(toggleRun)

    local function toggleSelect()
        selecting = not selecting
        if selecting then
            setStatus("Clique no ponto da água…", C.accent)
            areaBtn.Text = "Clique na água…  [Delete cancela]"
        else
            areaBtn.Text = "◎  Selecionar área da água  [Delete]"
            setStatus("Seleção cancelada.")
        end
    end
    areaBtn.MouseButton1Click:Connect(toggleSelect)

    local function overHud(p)
        local a, s = win.AbsolutePosition, win.AbsoluteSize
        return win.Visible and p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
    end

    local function refreshVis()
        marker.Visible = water ~= nil and win.Visible and body.Visible
        updateDexVis()
    end
    HUB.onChange[#HUB.onChange + 1] = refreshVis

    table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
        if i.KeyCode == Enum.KeyCode.Delete then
            if body.Visible then toggleSelect() end
        elseif selecting and i.UserInputType == Enum.UserInputType.MouseButton1 then
            local p = UIS:GetMouseLocation()
            if overHud(p) then return end
            water = p
            selecting = false
            marker.Position = UDim2.fromOffset(p.X, p.Y)
            refreshVis()
            areaBtn.Text = "◎  Selecionar área da água  [Delete]"
            setStatus("Área marcada. Aperte Iniciar.", C.ok)
            refreshInfo()
        end
    end))

    -- Scanner: lista elementos visíveis para descobrir os nomes/caminhos
    scanBtn.MouseButton1Click:Connect(function()
        local pg = lp:FindFirstChild("PlayerGui")
        local out = {}
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("GuiObject") and not o:IsDescendantOf(gui) and area(o) > 0 and visible(o) then
                local col = colorOf(o)
                local extra = ""
                if o:IsA("TextLabel") or o:IsA("TextButton") then extra = ' text="' .. o.Text .. '"' end
                if o:IsA("ImageLabel") then extra = " image=" .. tostring(o.Image) end
                table.insert(out, ("%s [%s] pos=(%d,%d) size=(%d,%d)%s%s"):format(
                    o:GetFullName(), o.ClassName, o.AbsolutePosition.X, o.AbsolutePosition.Y,
                    o.AbsoluteSize.X, o.AbsoluteSize.Y,
                    col and (" cor=" .. math.floor(col.R * 255) .. "," .. math.floor(col.G * 255) .. "," .. math.floor(col.B * 255)) or "",
                    extra))
            end
        end
        local txt = table.concat(out, "\n")
        local saved = {}
        if setclipboard then pcall(setclipboard, txt); table.insert(saved, "área de transferência") end
        if writefile then pcall(writefile, "caramelo_scan.txt", txt); table.insert(saved, "caramelo_scan.txt") end
        print(txt)
        setStatus(("Scanner: %d elementos. Salvo em: %s"):format(#out, #saved > 0 and table.concat(saved, " e ") or "console (F9)"), C.ok)
    end)

    ------------------------------------------------------------------ ANTI-AFK
    local VU
    pcall(function() VU = game:GetService("VirtualUser") end)
    local function paintAfk()
        afkBtn.Text = antiAfk and "☾  Anti-AFK: ligado" or "☾  Anti-AFK: desligado"
        afkBtn.BackgroundColor3 = antiAfk and C.panel or C.bg
        afkBtn.TextColor3 = antiAfk and C.ok or C.muted
    end
    afkBtn.MouseButton1Click:Connect(function() antiAfk = not antiAfk; paintAfk() end)
    paintAfk()
    table.insert(conns, lp.Idled:Connect(function()
        if false and VU then
            pcall(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end))

    ------------------------------------------------------------------ CRONÔMETRO
    task.spawn(function()
        while alive do
            local t = math.floor(elapsed + (runSince and (os.clock() - runSince) or 0))
            timeLbl.Text = ("Tempo de farm: %02d:%02d:%02d"):format(t // 3600, (t // 60) % 60, t % 60)
            task.wait(0.5)
        end
    end)

    ------------------------------------------------------------------ LIMPEZA
    local function destroy()
        alive, running = false, false
        pcall(setHold, false)
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        pcall(function() marker:Destroy() end)
        pcall(function() dex:Destroy() end)
    end

    task.spawn(worker)
    refreshInfo()

    return {
        destroy = destroy,
        isRunning = function() return running end,
        stop = function() if running then toggleRun() end end,
    }

end

local function MOD_COLETA(HUB)
