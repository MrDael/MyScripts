    ------------------------------------------------------------------ MINIGAME
    local function cy(o) return o.AbsolutePosition.Y + o.AbsoluteSize.Y / 2 end

    -- baú do tesouro (como no Stardew): objeto novo dentro da pista, ou com nome de baú
    local function isChestName(n)
        n = n:lower()
        return n:find("chest") or n:find("treasure") or n:find("bau") or n:find("baú") or n:find("tesouro") or n:find("loot")
    end
    local function under(o, a) return a and (o == a or o:IsDescendantOf(a)) end
    local function findChest(track, f, b, known)
        if not track then return nil end
        local best, bestScore
        local tA, tS = track.AbsolutePosition, track.AbsoluteSize
        for _, o in ipairs(track:GetDescendants()) do
            if o:IsA("GuiObject") and not under(o, f) and not under(o, b) and visible(o) and area(o) > 0 then
                local y = o.AbsolutePosition.Y + o.AbsoluteSize.Y / 2
                local inTrack = y >= tA.Y and y <= tA.Y + tS.Y and o.AbsoluteSize.Y <= tS.Y * 0.35
                local isNew = known and not known[o]
                if inTrack and (isNew or isChestName(o.Name)) then
                    local img = o:IsA("ImageLabel") and o.ImageTransparency < 1
                    local score = (isChestName(o.Name) and 10 or 0) + (isNew and 3 or 0) + (img and 2 or 0)
                    if not bestScore or score > bestScore then best, bestScore = o, score end
                end
            end
        end
        return best
    end
    local chestsSeen = 0

    -- devolve true se o peixe foi pescado (barra amarela quase cheia no fim)
    local function play()
        setStatus("Minigame em andamento…", C.accent)
        local lastBy, lastFy, lastT = nil, nil, os.clock()
        local velB, velF = 0, 0
        local lastSwitch = 0
        local lostSince
        local lastP = 0
        local known, track, chest, chestScan, chasing, chestBudget = nil, nil, nil, 0, false, 0
        local lastTgt
        while running and alive do
            local p = progressRatio()
            if p then lastP = p end
            local f, b = miniParts()
            if f and not known then
                track = f.Parent
                known = {}
                pcall(function() for _, o in ipairs(track:GetDescendants()) do known[o] = true end end)
            end
            if not rootOn() then
                lostSince = lostSince or os.clock()
                setHold(false)
                if os.clock() - lostSince > 0.6 then break end
                task.wait(0.03)
            elseif not f then
                lostSince = nil
                setHold(false)
                task.wait(0.03)
            else
                lostSince = nil
                local now = os.clock()
                local dt = math.max(now - lastT, 1 / 240)
                -- baú: procura a cada 0.15 s; vai nele quando o peixe está bem (barra cheia o bastante)
                if now - chestScan > 0.15 then
                    chestScan = now
                    local c2 = nil
                    pcall(function() c2 = findChest(track, f, b, known) end)
                    if c2 and not chest then
                        chestsSeen = chestsSeen + 1
                        chestBudget = 0
                        HUB.notify("good", "Baú do tesouro!", "Aparece no minigame, indo buscar.", { silent = false })
                        pcall(function()
                            if appendfile then
                                local ro, rs = Vector2.new(), Vector2.new()
                                if c2:IsA("ImageLabel") then ro, rs = c2.ImageRectOffset, c2.ImageRectSize end
                                appendfile("caramelo_pesca_log.txt", ("[bau] %s %s image=%s rect=%d,%d,%d,%d\n"):format(
                                    c2:GetFullName(), c2.ClassName, c2:IsA("ImageLabel") and c2.Image or "-", ro.X, ro.Y, rs.X, rs.Y))
                            end
                        end)
                    end
                    chest = c2
                end
                local tgt = f
                local cmode = HUB.gen.chestMode or 2 -- 1 ignorar · 2 pegar quando o peixe está seguro · 3 prioridade
                if cmode ~= 1 and chest and chest.Parent and area(chest) > 0 then
                    local pp = p or lastP
                    local onAt, offAt, maxB = 0.5, 0.3, 12
                    if cmode == 3 then onAt, offAt, maxB = 0.2, 0.1, 25 end
                    if chasing then
                        if pp < offAt or chestBudget > maxB then chasing = false end
                    elseif pp > onAt and chestBudget <= maxB then
                        chasing = true
                    end
                    if chasing then tgt = chest; chestBudget = chestBudget + dt end
                else
                    chasing = false
                end
                if tgt ~= lastTgt then lastTgt = tgt; lastFy = nil; velF = 0 end
                local by, fy = cy(b), cy(tgt)
                local rawB = lastBy and (by - lastBy) / dt or 0
                local rawF = lastFy and (fy - lastFy) / dt or 0
                velB = velB + (rawB - velB) * CFG.smooth
                velF = velF + (rawF - velF) * CFG.smooth
                lastBy, lastFy, lastT = by, fy, now

                -- erro previsto: posição relativa + velocidade relativa
                local v = (by - fy) + (velB - velF) * CFG.lookAhead -- positivo = barra abaixo do peixe → segurar
                local want = holding
                if v > CFG.deadzone then want = true
                elseif v < -CFG.deadzone then want = false end
                if want ~= holding and now - lastSwitch < CFG.minSwitch then want = holding end
                if want ~= holding then lastSwitch = now end
                setHold(want)
                task.wait()
            end
        end
        setHold(false)
        return lastP >= CFG.winProgress, lastP
    end

