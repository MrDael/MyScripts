    ------------------------------------------------------------------ MOUSE
    local function mouse(down, x, y)
        if CFG.useVIM and VIM then
            pcall(function() VIM:SendMouseButtonEvent(x, y, 0, down, game, 0) end)
        elseif mouse1press then
            if down then
                if mousemoveabs then pcall(mousemoveabs, x, y) end
                mouse1press()
            else
                mouse1release()
            end
        end
    end
    local function clickAt(p)
        mouse(true, p.X, p.Y)
        task.wait(math.random(40, 90) / 1000)
        mouse(false, p.X, p.Y)
    end
    local lastSend = 0
    local function setHold(state)
        if not water then return end
        local now = os.clock()
        if state ~= holding or now - lastSend > 0.25 then
            holding = state
            lastSend = now
            mouse(state, water.X, water.Y)
        end
    end
    local function rand(a, b) return a + math.random() * (b - a) end

    ------------------------------------------------------------------ DETECÇÃO
    local function resolve(path)
        if not path then return nil end
        local o = lp
        for part in path:gmatch("[^%.]+") do
            o = o and o:FindFirstChild(part)
            if not o then return nil end
        end
        return o
    end

    local function visible(o)
        local c = o
        while c and c ~= game do
            if c:IsA("GuiObject") and not c.Visible then return false end
            if c:IsA("LayerCollector") and not c.Enabled then return false end
            c = c.Parent
        end
        return true
    end

    local function colorOf(o)
        if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.ImageTransparency < 1
            and o.ImageColor3 ~= Color3.new(1, 1, 1) then
            return o.ImageColor3
        end
        if o.BackgroundTransparency < 1 then return o.BackgroundColor3 end
    end
    local function area(o) return o.AbsoluteSize.X * o.AbsoluteSize.Y end

    -- devolve peixe e barra se o minigame estiver na tela
    local function miniParts()
        local f, b = resolve(CFG.paths.fish), resolve(CFG.paths.bar)
        if f and b and f:IsA("GuiObject") and b:IsA("GuiObject")
            and area(f) > 0 and area(b) > 0 and visible(f) and visible(b) then
            return f, b
        end
    end
    local function rootOn()
        local r = resolve(CFG.paths.root)
        return r and r:IsA("GuiObject") and visible(r)
    end
    local function minigameOn() return rootOn() and miniParts() ~= nil end

    -- 0..1: quanto a barra amarela está cheia
    local function progressRatio()
        local p, back = resolve(CFG.paths.progress), resolve(CFG.paths.progressBack)
        if p and back and back.AbsoluteSize.Y > 0 then
            return math.clamp(p.AbsoluteSize.Y / back.AbsoluteSize.Y, 0, 1)
        end
    end

    -- exclamação: o ícone do balão fica amarelo (255,241,128) quando o peixe morde
    local function biteOn()
        local i = resolve(CFG.paths.biteIcon)
        if not (i and i:IsA("ImageLabel") and visible(i) and i.ImageTransparency < 0.9) then return false end
        local c = i.ImageColor3
        if c.R > 0.85 and c.G > 0.75 and c.B < 0.75 then return true end -- amarelo = fisgou
        return c.B > 0.55 and c.B > c.R + 0.15 and c.B >= c.G - 0.05 -- azul (85,170,255) = fisgou peixe raro
    end

    -- exclamação azul = vem peixe raro (o balão aparece azul antes de ficar amarelo)
    local function blueOn()
        local i = resolve(CFG.paths.biteIcon)
        if not (i and i:IsA("ImageLabel") and visible(i) and i.ImageTransparency < 0.9) then return false end
        local c = i.ImageColor3
        return c.B > 0.55 and c.B > c.R + 0.15 and c.B >= c.G - 0.05
    end
    local iconLogged = false
    local function logIcon()
        if iconLogged then return end
        local i = resolve(CFG.paths.biteIcon)
        if not (i and i:IsA("ImageLabel") and visible(i) and i.ImageTransparency < 0.9) then return end
        local c = i.ImageColor3
