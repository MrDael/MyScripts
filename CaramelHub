        if yellow or blueOn() then return end
        iconLogged = true -- ícone visível, nem amarelo nem azul: guarda o que é para eu ajustar
        pcall(function()
            if appendfile then
                appendfile("caramelo_pesca_log.txt", ("[icone?] color=%d,%d,%d image=%s\n"):format(
                    math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), tostring(i.Image)))
            end
        end)
