    function rebuildDex()
        for _, c in ipairs(dexList:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        seedGroupOrder()
        local groups, list, changed = {}, {}, false
        for k, e in pairs(fishLog) do
            local gid, base, m = groupInfo(k, e)
            local g = groups[gid]
            if not g then
                g = { gid = gid, base = base, count = 0, keys = {}, id = e.id, named = false }
                groups[gid] = g
                list[#list + 1] = g
            end
            g.count = g.count + e.count * m
            g.keys[#g.keys + 1] = k
            g.id = math.min(g.id, e.id)
            if isNamed(k) or k == "?" then g.named = true end
        end
        for _, g in ipairs(list) do
            if not indexOf(data.gorder, g.gid) then data.gorder[#data.gorder + 1] = g.gid; changed = true end
        end
        if changed then saveData() end
        local rank = {}
        for i, gid in ipairs(data.gorder) do rank[gid] = i end
        table.sort(list, function(a, b)
            local ra, rb = rank[a.gid] or math.huge, rank[b.gid] or math.huge
            if ra ~= rb then return ra < rb end
            return a.id < b.id
        end)

        local total = 0
        for i, g in ipairs(list) do
            total = total + g.count
            local row = new("Frame", { Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = C.panel, LayoutOrder = i }, dexList)
            round(row, 10)
            local bar = new("Frame", { Size = UDim2.fromOffset(4, 22), Position = UDim2.fromOffset(8, 9),
                BackgroundColor3 = g.named and C.ok or C.accent, BorderSizePixel = 0 }, row)
            round(bar, 2)
            local single = #g.keys == 1
            local box = new("TextBox", {
                Text = single and displayName(g.keys[1], fishLog[g.keys[1]]) or g.base,
                PlaceholderText = "nome", ClearTextOnFocus = false,
                Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text, TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -168, 1, 0),
            }, row)
            box.FocusLost:Connect(function()
                local typed = trim(box.Text)
                if typed ~= "" then
                    if single then
                        data.names[g.keys[1]] = typed
                    else
                        -- vários avisos na mesma linha: troca só o nome base e mantém cada ×N
                        local tb = parseName(typed)
                        for _, k in ipairs(g.keys) do
                            local _, m = parseName(displayName(k, fishLog[k]))
                            data.names[k] = tb .. (m > 1 and (" ×" .. m) or "")
                        end
                    end
                    saveData()
                end
                rebuildDex()
            end)
            local pill = new("TextLabel", {
                Text = "×" .. g.count, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.accent,
                BackgroundColor3 = C.bg, Position = UDim2.new(1, -144, 0.5, -11), Size = UDim2.fromOffset(54, 22),
            }, row)
            round(pill, 11)
            local up   = smallBtn(row, "▲", -86, C.muted, i > 1)
            local down = smallBtn(row, "▼", -58, C.muted, i < #list)
            local del  = smallBtn(row, "✕", -30, C.accent, true)
            up.MouseButton1Click:Connect(function()
                if i > 1 then swapGroups(g.gid, list[i - 1].gid); rebuildDex() end
            end)
            down.MouseButton1Click:Connect(function()
                if i < #list then swapGroups(g.gid, list[i + 1].gid); rebuildDex() end
            end)
            del.MouseButton1Click:Connect(function()
                -- apaga a linha e passa a ignorar esses avisos (para erros de detecção)
                local gone = {}
                for _, k in ipairs(g.keys) do
                    gone[k] = true
                    fishLog[k] = nil
                    data.blocked[k] = true
                    local oi = indexOf(data.order, k)
                    if oi then table.remove(data.order, oi) end
                end
                local gi = indexOf(data.gorder, g.gid)
                if gi then table.remove(data.gorder, gi) end
                local keep = {}
                for _, q in ipairs(pendingQ) do if not gone[q.key] then keep[#keep + 1] = q end end
                pendingQ = keep
                saveData()
                layoutDex(); rebuildDex()
            end)
        end
        dexTotal.Text = "Total " .. total
        emptyLbl.Visible = #list == 0
    end

