local function showToast(kind, title, text)
    toastN = toastN + 1
    local f = new("Frame", { BackgroundColor3 = C.bg, Size = UDim2.fromOffset(300, 48), LayoutOrder = toastN,
        BorderSizePixel = 0 }, toastHost)
    round(f, 10)
    new("UIStroke", { Color = KIND_COLOR[kind] or C.muted, Thickness = 1.5 }, f)
    new("TextLabel", { Text = title, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = KIND_COLOR[kind] or C.text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -24, 0, 16) }, f)
    new("TextLabel", { Text = text, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 23), Size = UDim2.new(1, -24, 0, 18) }, f)
    task.delay(7, function() if f.Parent then f:Destroy() end end)
    local kids = {}
    for _, c in ipairs(toastHost:GetChildren()) do if c:IsA("Frame") then kids[#kids + 1] = c end end
    table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    while #kids > 4 do table.remove(kids, 1):Destroy() end
end

-- histórico de avisos (aparece na aba Geral)
local history, histCbs = {}, {}
local function notify(kind, title, text, opts)
    text = tostring(text or "")
    history[#history + 1] = { t = os.date("%H:%M:%S"), kind = kind, title = title, text = text }
    if #history > 120 then table.remove(history, 1) end
    for _, f in ipairs(histCbs) do pcall(f) end
    if opts and opts.silent then return end
    if gen.toast then pcall(showToast, kind, title, text) end
    playSound(kind)
end

-- reset da mina (lido do estado que o servidor manda; "—" se o formato não bater)
local mineAtomFn
task.spawn(function()
    pcall(function()
        local m = RS.TS.store:FindFirstChild("mine-cycle-atom")
        local mod = m and requireTimeout(m)
        if type(mod) == "table" and type(mod.mineCycleAtom) == "function" then mineAtomFn = mod.mineCycleAtom end
    end)
end)
local function endsCandidates(v, depth, out)
    if type(v) == "number" then out[#out + 1] = v
    elseif type(v) == "table" and depth < 3 then
        for k, x in pairs(v) do
            if type(x) == "number" and tostring(k):lower():find("end") then out[#out + 1] = x
            elseif type(x) == "table" then endsCandidates(x, depth + 1, out) end
        end
    end
end
local function mineRemaining()
    if not mineAtomFn then return nil end
    local ok, v = pcall(mineAtomFn)
    if not ok or v == nil then return nil end
    local cands = {}
    endsCandidates(v, 0, cands)
    for _, x in ipairs(cands) do
        for _, base in ipairs({ x - srvNow(), x - os.time(), x / 1000 - srvNow(), x / 1000 - os.time() }) do
            if base >= -3 and base <= 640 then return math.max(0, base) end
        end
    end
    return nil
end

