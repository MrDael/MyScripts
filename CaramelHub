    pcall(function() VU = game:GetService("VirtualUser") end)
    table.insert(conns, lp.Idled:Connect(function()
        if false and VU then
            pcall(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end))

    ------------------------------------------------------------------ LIMPEZA
    local function destroy()
        alive, running = false, false
        pcall(releaseAll)
        if learnedDirty then pcall(saveMap) end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        for _, m in ipairs(markers) do pcall(function() m:Destroy() end) end
    end

    ------------------------------------------------------------------ INÍCIO
    task.spawn(function() pcall(loadGameRarities) end)
    task.spawn(function() -- relê o mapa
        while alive do
            pcall(scan)
            pcall(rebuildTypes)
            task.wait(CFG.rescan)
        end
    end)
    task.spawn(function() -- marcadores
        while alive do
            pcall(updateEsp)
            task.wait(0.08)
        end
    end)
    task.spawn(function() -- estatísticas
        while alive do
            pcall(refreshStats)
            task.wait(0.5)
        end
    end)
