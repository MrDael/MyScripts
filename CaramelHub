        reBtn.TextColor3 = cfg.reenter and C.ok or C.muted
        afkBtn.Text = cfg.antiAfk and "☾  Anti-AFK: ligado" or "☾  Anti-AFK: desligado"
        afkBtn.TextColor3 = cfg.antiAfk and C.ok or C.muted
    end
    paintButtons()
    modeBtn.MouseButton1Click:Connect(function() cfg.mode = cfg.mode % 3 + 1; save(); paintButtons() end)
    chestBtn.MouseButton1Click:Connect(function() cfg.chests = not cfg.chests; save(); paintButtons() end)
    asapBtn.MouseButton1Click:Connect(function() cfg.asap = not cfg.asap; save(); paintButtons() end)
    reBtn.MouseButton1Click:Connect(function() cfg.reenter = not cfg.reenter; save(); paintButtons() end)
    afkBtn.MouseButton1Click:Connect(function() cfg.antiAfk = not cfg.antiAfk; save(); paintButtons() end)
    forgetBtn.MouseButton1Click:Connect(function()
        learned, learnedDirty = {}, false
        locked, typeFails = {}, {}
        typesSig = ""
        setStatus("Bloqueios aprendidos e travas de picareta apagados.", C.ok)
    end)
    markBtn.MouseButton1Click:Connect(function()
        local r = myRoot()
        local world = workspace:FindFirstChild(CFG.worldName)
        if not (r and world) then return end
        local best, bd
        for _, o in ipairs(world:GetChildren()) do
            if o:IsA("BasePart") then
                local pr = o:FindFirstChildOfClass("ProximityPrompt")
                if pr then
                    local d = (o.Position - r.Position).Magnitude - (pr.Enabled and 1000 or 0)
                    if not bd or d < bd then best, bd = o, d end
                end
            end
        end
        if best then
            local id = best:GetAttribute("Id")
            cfg.entrance = { name = best.Name, id = type(id) == "string" and id or "" }
            save()
            setStatus(("Entrada marcada: %s. Vou usar esse ponto para reentrar na mina."):format(best.Name), C.ok)
        else
            setStatus("Nenhum botão de interação por perto. Chegue perto da entrada da mina.", C.accent)
        end
    end)

    local function refreshStats()
        local t = elapsed + (runSince and (os.clock() - runSince) or 0)
        line1.Text = ("Andar: %s  ·  %s"):format(floor and tostring(floor) or "?", worldInMine() and "dentro da mina" or "fora da mina")
        local parts = {}
        for n, c in pairs(cfg.totals.ore) do parts[#parts + 1] = { ORE_ORDER[n] or 99, ("%s ×%d"):format(oreLabel(n), c) } end
        table.sort(parts, function(a, b) return a[1] < b[1] end)
        local txt = {}
        for _, p in ipairs(parts) do txt[#txt + 1] = p[2] end
        line2.Text = #txt > 0 and table.concat(txt, "  ·  ") or "Nenhum minério ainda."
        local tot = stat.hits + stat.miss
        line3.Text = ("Baús: %d · Andares: %d · Golpes: %d/%d · %s"):format(cfg.totals.chests, cfg.totals.floors,
            stat.hits, tot, fmtTime(t))
    end

    ------------------------------------------------------------------ LOOP PRINCIPAL
    local function stopRun(msg)
        running = false
        if runSince then elapsed = elapsed + (os.clock() - runSince); runSince = nil end
        startBtn.Text = "▶  Iniciar mineração"
        startBtn.BackgroundColor3 = C.accent
        releaseAll()
        if msg then
            setStatus(msg, C.accent)
            if msg ~= "Parado." then HUB.notify("warn", "Mineração parou", msg) end
        end
    end

    local function worker()
        local wasMine = false
        while alive do
            if not running then
                task.wait(0.2)
            else
                local r = myRoot()
                if not r then
                    setStatus("Aguardando o personagem…")
                    task.wait(0.5)
                elseif not basis then
                    setStatus("Calibrando as teclas (andando um pouco)…", C.accent)
                    if not calibrate() then
                        stopRun("Não consegui calibrar. Fique numa área aberta e tente de novo.")
                    else
                        setStatus("Calibrado!", C.ok)
                    end
                else
                    scan()
                    local me = xz(r.Position)
                    local inMine = worldInMine()
                    if inMine and not wasMine then
                        surfaceSince = nil
                        entryFails = 0
                    end
                    if wasMine and not inMine then
                        local rem = HUB.mineRemaining and HUB.mineRemaining()
                        dbg("saí da mina (cena=" .. tostring(sceneIsMine) .. ", ciclo restante=" .. (rem and ("%.0f s"):format(rem) or "?") .. ")")
                        HUB.notify("info", "Mineração", "Fora da mina. Voltando…", { silent = true })
                    end
                    wasMine = inMine
                    if sceneChanging and os.clock() - changedAt > 15 then
                        -- o aviso de "cena carregada" não chegou: não fica esperando para sempre
                        sceneChanging = false
                        floor = pendingFloor
                        sceneIsMine = pendingIsMine
                        sceneEpoch = sceneEpoch + 1
                        resetFloorState()
                        dbg("troca de cena demorou demais; segui em frente")
                    end

                    if sceneChanging or os.clock() - changedAt < 1.5 then
                        setStatus("Trocando de cena…")
                        task.wait(0.3)
                    elseif not inMine then
                        surfaceSince = surfaceSince or os.clock()
                        if os.clock() - surfaceSince < 1.2 then
                            task.wait(0.3)
                        elseif not cfg.reenter then
                            setStatus("Fora da mina. Reentrada automática desligada.", C.accent)
                            task.wait(1)
                        elseif entryFails >= 8 then
                            stopRun("Não consegui entrar na mina sozinho. Marque a entrada (perto dela) e tente de novo.")
                        else
                            local ok = enterMine(me)
                            if ok then
                                entryFails = 0
                                dbg("entrou na mina")
                                HUB.notify("info", "Mineração", "Entrou na mina de novo", { silent = true })
                            else
                                entryFails = entryFails + 1
                                dbg("falha ao entrar na mina (" .. entryFails .. ")")
                                task.wait(2 + entryFails)
                            end
                        end
                    else
                        surfaceSince = nil
                        local act = decide(me)
                        local it = act.it
                        if act.kind == "wait" then
                            setStatus(act.why or "Esperando…")
                            task.wait(1.0)
                        elseif act.kind == "descend" then
                            setStatus(("Descendo para o andar %s…"):format(floor and tostring(floor + 1) or "?"), C.ok)
                            if not descend(it) and running and stillThere(it) then
                                attempts[it.part] = (attempts[it.part] or 0) + 1
                                if attempts[it.part] >= CFG.maxAttempts then
                                    skipUntil[it.part] = os.clock() + 30
                                    attempts[it.part] = nil
                                end
                                setStatus("Não consegui descer (" .. lastNavError .. "). Tentando de novo…", C.accent)
                                task.wait(0.8)
                            end
                        elseif act.kind == "chest" then
                            setStatus("Indo até o baú…", C.ok)
                            if not collectChest(it) and running and stillThere(it) then
                                attempts[it.part] = (attempts[it.part] or 0) + 1
                                if attempts[it.part] >= CFG.maxAttempts then
                                    skipUntil[it.part] = os.clock() + CFG.skipSeconds
                                    attempts[it.part] = nil
                                end
                            end
                        else
                            setStatus(("Minerando %s%s (%dm)…"):format(oreLabel(it.name),
                                act.why and (" — " .. act.why) or "", math.floor(dist2(it, me))))
                            local res = mineNode(it)
                            if res == "reward" then
                                attempts[it.part] = nil
                                typeFails[it.name] = nil
                                setStatus(("Coletou %s!"):format(oreLabel(it.name)), C.ok)
                            elseif running then
                                attempts[it.part] = (attempts[it.part] or 0) + 1
                                if res == "nostart" or res == "noprompt" then
                                    typeFails[it.name] = (typeFails[it.name] or 0) + 1
                                    if typeFails[it.name] >= 3 then
                                        locked[it.name] = true
                                        typesSig = ""
                                        setStatus(("%s: o minigame não abre. Picareta fraca ou sem picareta na mão? Vou pular esse tipo."):format(oreLabel(it.name)), C.accent)
                                        task.wait(1.5)
                                    end
                                end
                                if attempts[it.part] >= CFG.maxAttempts then
                                    skipUntil[it.part] = os.clock() + CFG.skipSeconds
                                    attempts[it.part] = nil
                                end
                                dbg("mineNode falhou: " .. tostring(res) .. " " .. it.name)
                            end
                        end
                        task.wait(0.2 + math.random() * 0.2)
                    end
                end
            end
        end
    end

    local function toggleRun()
        if running then
            stopRun("Parado.")
        else
            running = true
            runSince = os.clock()
            startBtn.Text = "■  Parar"
            startBtn.BackgroundColor3 = C.line
            setStatus("Iniciando…")
        end
    end
    startBtn.MouseButton1Click:Connect(toggleRun)


    local VU
    pcall(function() VU = game:GetService("VirtualUser") end)
    table.insert(conns, lp.Idled:Connect(function()
        if false and VU then
            pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new(0, 0)) end)
        end
    end))

    local function destroy()
        alive, running = false, false
        pcall(releaseAll)
        save()
        pcall(function() if writefile then writefile(LOGFILE, table.concat(logLines, "\n")) end end)
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end

    ------------------------------------------------------------------ INÍCIO
    do
        local missing = {}
        for k, v in pairs(evOk) do if not v then missing[#missing + 1] = k end end
        if #missing > 0 then dbg("eventos não encontrados: " .. table.concat(missing, ",")) end
    end
    dbg("script iniciado")
    task.spawn(function()
        while alive do
            pcall(refreshStats)
            pcall(rebuildTypes)
            if logDirty then
                logDirty = false
                pcall(function() if writefile then writefile(LOGFILE, table.concat(logLines, "\n")) end end)
            end
            task.wait(0.5)
        end
    end)
    task.spawn(function() -- lê o mundo mesmo parado, para a lista de minérios aparecer
        while alive do
            if not running then pcall(scan) end
            task.wait(1.0)
        end
    end)
    task.spawn(worker)

    return {
        destroy = destroy,
        isRunning = function() return running end,
        stop = function() if running then toggleRun() end end,
    }

end

local function MOD_HORTA(HUB)
