    local function fmtTime(t)
        t = math.floor(t)
        return ("%02d:%02d:%02d"):format(t // 3600, (t // 60) % 60, t % 60)
    end
    local function refreshStats()
        local t = elapsed + (runSince and (os.clock() - runSince) or 0)
        stats.Text = ("Coletados: %d · Raros+: %d · %s"):format(collectedTotal, collectedRare, fmtTime(t))
        local parts = {}
